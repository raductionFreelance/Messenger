<Window x:Class="MessengerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messenger"
        Height="600"
        Width="1000">

    <Grid Margin="5">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>


        <GroupBox Header="Чати"
                  Grid.Column="0"
                  Margin="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Margin="5" Height="25" x:Name="chatNameTextBox"/>

                <ListBox Grid.Row="1" Margin="5" x:Name="chatList">
                </ListBox>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="5">

                    <Button Content="Додати"
                            Width="80"
                            Margin="5"
                            Click="AddChatButton_Click"/>

                    <Button Content="Видалити"
                            Width="80"
                            Margin="5" 
                            Click="DeleteChatRoomButton_Click"
                            />

                </StackPanel>

            </Grid>

        </GroupBox>


        <GroupBox Header="Повідомлення"
                  Grid.Column="1"
                  Margin="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="5" FontWeight="Bold" Text="Чат: " x:Name="chatNameTextBlock"/>

                <ListBox Grid.Row="1" Margin="5" x:Name="messageList">
                </ListBox>

                <Grid Grid.Row="2"
                      Margin="5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Height="25" Margin="0,0,5,0" x:Name="messageTextBox"/>

                    <Button Grid.Column="1"
                            Content="Надіслати"
                            Click="SendMessage_Click"/>

                </Grid>

            </Grid>

        </GroupBox>


        <GroupBox Header="Керування"
                  Grid.Column="2"
                  Margin="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="5">

                    <TextBlock Text="Користувач: " x:Name="userNameTextBlock"/>
                    <TextBlock Text="Статус: " x:Name="userStatusTextBlock"/>

                </StackPanel>

                <ListBox Grid.Row="1" Margin="5" x:Name="userList">

                </ListBox>

                <StackPanel Grid.Row="2"
                            Margin="5">

                    <Button Content="Додати учасника"
                            Margin="0,0,0,5" Click="AddUserToChat_Click"/>

                    <Button Content="Видалити учасника"
                            Margin="0,0,0,5"/>

                </StackPanel>

            </Grid>

        </GroupBox>

    </Grid>
</Window>
