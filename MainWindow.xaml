<Window x:Class="MessengerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Messenger"
        Height="600"
        Width="1000">

    <Grid Margin="5">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>


        <GroupBox Header="Чати"
                  Grid.Column="0"
                  Margin="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Margin="5"
                         Height="25"/>

                <ListBox Grid.Row="1"
                         Margin="5">

                    <ListBoxItem Content="Олександр"/>
                    <ListBoxItem Content="Марія"/>
                    <ListBoxItem Content="Чат розробників"/>
                    <ListBoxItem Content="Команда"/>

                </ListBox>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="5">

                    <Button Content="Додати"
                            Width="80"
                            Margin="5"/>

                    <Button Content="Видалити"
                            Width="80"
                            Margin="5"/>

                </StackPanel>

            </Grid>

        </GroupBox>


        <GroupBox Header="Повідомлення"
                  Grid.Column="1"
                  Margin="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="5"
                           FontWeight="Bold"
                           Text="Чат: Чат розробників"/>

                <ListBox Grid.Row="1"
                         Margin="5">

                    <ListBoxItem>
                        <StackPanel>
                            <TextBlock FontWeight="Bold"
                                       Text="Олександр"/>
                            <TextBlock Text="Привіт!"/>
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem>
                        <StackPanel>
                            <TextBlock FontWeight="Bold"
                                       Text="Марія"/>
                            <TextBlock Text="Як справи?"/>
                        </StackPanel>
                    </ListBoxItem>

                </ListBox>

                <Grid Grid.Row="2"
                      Margin="5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="25"
                             Margin="0,0,5,0"/>

                    <Button Grid.Column="1"
                            Content="Надіслати"/>

                </Grid>

            </Grid>

        </GroupBox>


        <GroupBox Header="Керування"
                  Grid.Column="2"
                  Margin="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="5">

                    <TextBlock Text="Користувач: Admin"/>
                    <TextBlock Text="Статус: Online"/>

                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="5">

                    <ListBoxItem Content="Олександр"/>
                    <ListBoxItem Content="Марія"/>
                    <ListBoxItem Content="Іван"/>

                </ListBox>

                <StackPanel Grid.Row="2"
                            Margin="5">

                    <Button Content="Додати учасника"
                            Margin="0,0,0,5"/>

                    <Button Content="Видалити учасника"
                            Margin="0,0,0,5"/>

                    <Button Content="Заблокувати"/>

                </StackPanel>

            </Grid>

        </GroupBox>

    </Grid>
</Window>